# Copie este ficheiro para .env.local e preencha com os valores do seu projeto.
# Supabase -> Project Settings -> API
#
# .env.local nunca e commitado (ver .gitignore).

# URL do projeto, ex: https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Chave publica (anon / publishable). Pode ir para o browser: a RLS e que
# protege os dados. NUNCA colocar aqui a service_role key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Endereco publico do app (base dos links de email e do retorno do Google).
# Tem de estar tambem em Supabase -> Authentication -> URL Configuration.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
